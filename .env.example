# Copy to .env and fill in (PowerShell: Copy-Item .env.example .env)

AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
# Optional: direct OpenAI key (used if AI_INTEGRATIONS_OPENAI_API_KEY is empty)
OPENAI_API_KEY=

# Optional: override model used by generic generation endpoints
# OPENAI_MODEL=gpt-5.1

# With `docker compose up`, Postgres is on host port 5433 (see docker-compose.yml).
# In URLs, encode @ in passwords as %40.
DATABASE_URL=postgresql://smart_edu:smart_edu_local@127.0.0.1:5433/smart_edu_hub_utf8

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SESSION_SECRET=

# Fast2SMS API key for mobile OTP delivery (signup).
# If left blank, the dev server logs the OTP to the console instead of sending SMS.
FAST2SMS_API_KEY=

PORT=5000
